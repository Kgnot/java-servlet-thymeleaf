<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <!-- Unidad para escritura -->
    <persistence-unit name="CRM_WRITE" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>org.server.model.entities.UserEntity</class>

        <properties>
            <!-- JDBC -->
            <!-- Esto se hace en tiempo de ejecución-->

            <!-- Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- HikariCP -->
            <property name="hibernate.hikari.minimumIdle" value="5"/>
            <property name="hibernate.hikari.maximumPoolSize" value="15"/>
            <property name="hibernate.hikari.poolName" value="CRM-Write-Pool"/>
        </properties>
    </persistence-unit>

    <!-- Unidad para lectura -->
    <persistence-unit name="CRM_READ" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>org.server.model.entities.UserEntity</class>

        <properties>
            <!-- JDBC -->
            <!-- Esto se hace en tiempo de ejecución-->

            <!-- Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>

            <!-- HikariCP -->
            <property name="hibernate.hikari.minimumIdle" value="3"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.poolName" value="CRM-Read-Pool"/>
        </properties>
    </persistence-unit>

</persistence>
